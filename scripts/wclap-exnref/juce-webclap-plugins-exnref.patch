-add_compile_options(-msimd128 -fwasm-exceptions -fno-math-errno -fno-trapping-math
+add_compile_options(-msimd128 -fwasm-exceptions -sWASM_LEGACY_EXCEPTIONS=0 -fno-math-errno -fno-trapping-math
