@@ -4,13 +4,13 @@
 set -euo pipefail
 
 ROOT="$(cd "$(dirname "$0")/.." && pwd)"
-BUILD="$ROOT/build/surge-xt"
+BUILD="${SURGE_BUILD_DIR:-$ROOT/build/surge-xt}"
 WEB="$BUILD/web"
