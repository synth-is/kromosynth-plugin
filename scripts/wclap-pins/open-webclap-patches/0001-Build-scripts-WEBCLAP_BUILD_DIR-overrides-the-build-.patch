index d064d8b..e119350 100755
--- a/scripts/build-ripplerx.sh
+++ b/scripts/build-ripplerx.sh
@@ -4,7 +4,7 @@
 set -euo pipefail
 
 ROOT="$(cd "$(dirname "$0")/.." && pwd)"
-BUILD="$ROOT/build/ripplerx"
+BUILD="${WEBCLAP_BUILD_DIR:-$ROOT/build/ripplerx}"
