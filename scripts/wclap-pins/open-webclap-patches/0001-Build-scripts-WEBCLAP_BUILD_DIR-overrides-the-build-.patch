diff --git a/scripts/build-six-sines.sh b/scripts/build-six-sines.sh
index 9d9d943..c1aaed4 100755
--- a/scripts/build-six-sines.sh
+++ b/scripts/build-six-sines.sh
@@ -4,7 +4,7 @@
 set -euo pipefail
 
