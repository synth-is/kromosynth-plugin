From 583c4ceae73ca59a586b4dfa4bf3f563c59893b3 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bj=C3=B6rn=20=C3=9E=C3=B3r=20J=C3=B3nsson?= <bangsi@bthj.is>
Date: Thu, 22 Oct 2026 00:11:57 +0000
Subject: [PATCH 1/3] Build scripts: WEBCLAP_BUILD_DIR overrides the build
 directory

Lets two builds of one port (e.g. legacy and exnref exceptions) sit side by side;
they cannot share a build directory because their objects do not link together.
Default unchanged.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 scripts/build-obxf.sh      | 2 +-
 scripts/build-odin2.sh     | 2 +-
 scripts/build-ripplerx.sh  | 2 +-
 scripts/build-six-sines.sh | 2 +-
 scripts/build-surge-xt.sh  | 2 +-
 5 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/scripts/build-obxf.sh b/scripts/build-obxf.sh
index 2e972ad..92d267c 100755
--- a/scripts/build-obxf.sh
+++ b/scripts/build-obxf.sh
@@ -4,7 +4,7 @@
 set -euo pipefail
 
 ROOT="$(cd "$(dirname "$0")/.." && pwd)"
-BUILD="$ROOT/build/obxf"
+BUILD="${WEBCLAP_BUILD_DIR:-$ROOT/build/obxf}"
 WEB="$BUILD/web"
 BUNDLE="$WEB/obxf.wclap"
 
diff --git a/scripts/build-odin2.sh b/scripts/build-odin2.sh
index ddd74c2..21f76a6 100755
--- a/scripts/build-odin2.sh
+++ b/scripts/build-odin2.sh
@@ -4,7 +4,7 @@
 set -euo pipefail
 
 ROOT="$(cd "$(dirname "$0")/.." && pwd)"
-BUILD="$ROOT/build/odin2"
+BUILD="${WEBCLAP_BUILD_DIR:-$ROOT/build/odin2}"
 WEB="$BUILD/web"
 BUNDLE="$WEB/odin2.wclap"
 
