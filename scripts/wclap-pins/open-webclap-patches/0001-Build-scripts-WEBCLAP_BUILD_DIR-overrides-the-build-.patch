diff --git a/scripts/build-surge-xt.sh b/scripts/build-surge-xt.sh
index f10c154..c0dac97 100755
--- a/scripts/build-surge-xt.sh
+++ b/scripts/build-surge-xt.sh
@@ -4,7 +4,7 @@
