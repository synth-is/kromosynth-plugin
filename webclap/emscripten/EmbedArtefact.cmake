#
# synthis-et4.17: write one Faust artefact (<stem>.wasm, <stem>.json, <stem>.plan) into a C++ header, so the WCLAP
# module carries it. A WCLAP has no file system to read it from at run time (wclap-host-node gives no preopened
# directories, and the kit links STANDALONE_WASM). Called at configure time by CMakeLists.txt:
#
#   synthis_embed_faust_artefact(<stem> <out header>)

function(_synthis_hex_array file var)
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR bytes "${n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    # Line breaks every 32 bytes keep the header readable by an editor.
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" hex "${hex}")
    set(${var} "${hex}" PARENT_SCOPE)
    set(${var}_SIZE "${bytes}" PARENT_SCOPE)
endfunction()

function(synthis_embed_faust_artefact stem out)
    foreach(ext wasm json plan)
        if(NOT EXISTS "${stem}.${ext}")
            message(FATAL_ERROR "Faust artefact incomplete: no ${stem}.${ext}")
        endif()
    endforeach()
    _synthis_hex_array("${stem}.wasm" W)
    _synthis_hex_array("${stem}.json" J)
    _synthis_hex_array("${stem}.plan" P)
    get_filename_component(name "${stem}" NAME)
    file(WRITE "${out}.tmp"
"// Generated by webclap/emscripten/EmbedArtefact.cmake from ${stem}.{wasm,json,plan}. Do not edit.
#pragma once
#include <cstddef>
namespace synthis_artefact {
inline constexpr const char* kName = \"${name}\";
inline constexpr unsigned char kWasm[] = {
${W}};
inline constexpr std::size_t kWasmSize = ${W_SIZE};
inline constexpr unsigned char kJson[] = {
${J} 0 };
inline constexpr unsigned char kPlan[] = {
${P} 0 };
}
")
    # Only touch the header when it changed, so a reconfigure does not rebuild the processor.
    file(COPY_FILE "${out}.tmp" "${out}" ONLY_IF_DIFFERENT)
    file(REMOVE "${out}.tmp")
    message(STATUS "Faust artefact embedded: ${name} (${W_SIZE} bytes of wasm)")
endfunction()
