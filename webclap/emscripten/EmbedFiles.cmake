#
# synthis-et4.18: write a set of files into a C++ header as byte arrays, so the WCLAP module carries them (the
# sampler spike's test SFZ and WAV). The module writes them into its in-memory file system at activate time.
#
#   synthis_embed_files(<out header> <file>...)
#
# The header defines synthis_files::kFiles[] = { { name, bytes, size }, ... } and kNumFiles; name is the file's
# base name.

include("${CMAKE_CURRENT_LIST_DIR}/EmbedArtefact.cmake")   # _synthis_hex_array

function(synthis_embed_files out)
    set(arrays "")
    set(table "")
    set(i 0)
    set(total 0)
    foreach(f IN LISTS ARGN)
        if(NOT EXISTS "${f}")
            message(FATAL_ERROR "synthis_embed_files: no ${f}")
        endif()
        _synthis_hex_array("${f}" H)
        get_filename_component(name "${f}" NAME)
        string(APPEND arrays "inline constexpr unsigned char kFile${i}[] = {\n${H}};\n")
        string(APPEND table "    { \"${name}\", kFile${i}, ${H_SIZE} },\n")
        math(EXPR i "${i} + 1")
        math(EXPR total "${total} + ${H_SIZE}")
    endforeach()
    file(WRITE "${out}.tmp"
"// Generated by webclap/emscripten/EmbedFiles.cmake. Do not edit.
#pragma once
#include <cstddef>
namespace synthis_files {
struct File { const char* name; const unsigned char* bytes; std::size_t size; };
${arrays}inline constexpr File kFiles[] = {
${table}};
inline constexpr int kNumFiles = ${i};
}
")
    file(COPY_FILE "${out}.tmp" "${out}" ONLY_IF_DIFFERENT)
    file(REMOVE "${out}.tmp")
    message(STATUS "Embedded ${i} files, ${total} bytes")
endfunction()
